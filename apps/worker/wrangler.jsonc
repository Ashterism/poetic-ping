{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poetic-ping-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://cjxpbvrlwxkcmqdqdqbu.supabase.co",
    "ZITADEL_ISSUER": "https://ashterix-mkjzns.eu1.zitadel.cloud",
    "ZITADEL_AUDIENCE": "390021886861484201",
    "ALLOWED_ORIGIN": "http://localhost:5173,https://poetic-ping.ashterix.com",
    "FROM_EMAIL": "Poetic Ping <reminders@example.com>"
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
